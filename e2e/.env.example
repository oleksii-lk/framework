# Copy this file to .env and adjust values for your environment.
# Playwright loads .env automatically before running tests.
# In CI, set these as real environment variables instead.

# Primary test user credentials (must exist in the backend's user store)
TEST_USER_USERNAME=alice
TEST_USER_PASSWORD=password123

# Service URLs
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
